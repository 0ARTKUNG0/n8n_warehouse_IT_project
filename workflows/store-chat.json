        "emailType": "text",
        "message": "={{ $json.execution.error.message }}\nStep: {{ $json.execution.lastNodeExecuted }}\nOpen: {{ $json.execution.url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "oDZaXI1qofa3HUa3",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
