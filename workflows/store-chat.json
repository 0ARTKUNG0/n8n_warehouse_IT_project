    {
      "id": "8a22b86b-154f-4cdb-bce5-3f872946567d",
      "name": "Get Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        440,
        300
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "authentication": "oAuth2",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "inventory"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Inventory"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "aiEpt4MCfgtCCgZ1",
          "name": "Google Sheets account"
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "8ab82e5a-bdec-4a1a-98e1-9b4dc378a7a8",
      "name": "Prepare Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Read the website's request and turn the product list (from the Google Sheet) into text for the AI.\nconst body = $('Webhook').first(0).json.body ?? {};\nconst txt = v => String(v ?? '').trim();\nconst num = v => (typeof v === 'number' ? v : txt(v) === '' ? NaN : Number(txt(v).replace(/[^0-9.-]/g, '')));\nconst session_id = txt(body.session_id) || 'guest';\nconst sku = txt(body.product_sku).toUpperCase();\n// opened from a sold-out product page with no message yet\nconst message = txt(body.message).slice(0, 1000) || (sku ? `สินค้า ${sku} หมด ช่วยแนะนำตัวอื่นให้หน่อย` : 'สวัสดี');\n\nconst money = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n// rows with a missing sku, name or price are skipped\nconst products = $input.all().map(i => i.json)\n  .filter(p => txt(p.sku) && txt(p.name) && Number.isFinite(num(p.price_ex_vat)));\nconst products_text = products.map(p => [\n  txt(p.sku).toUpperCase(), txt(p.name), txt(p.category),\n  `฿${money(num(p.price_ex_vat))} before VAT, ฿${money(num(p.price_ex_vat) * 1.07)} incl. VAT`,\n  num(p.stock_qty) > 0 ? `in stock: ${num(p.stock_qty)}` : 'SOLD OUT',\n  `tags: ${txt(p.tags)}`,\n  txt(p.description).slice(0, 250),\n].join(' | ')).join('\\n') || 'The product list is not available right now. Do not name any products.';\n\nreturn [{ json: { session_id, message, products_text } }];\n"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "e6373cee-b4e1-41c6-9f19-fc3701ff33ea",
      "name": "Router",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "Classify the customer's message for a computer-hardware store. Answer with exactly one word:\nhardware = questions about products, recommendations, specs, stock, sold-out products, or the customer telling what they will use a product for\ncalculator = prices for quantities, totals, VAT, quotations\ntroubleshooter = problems, setup, drivers, warranty, returns, orders, delivery\nIf unsure, answer hardware.",
          "maxIterations": 3,
          "enableStreaming": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "6945ec9f-a1a4-4ee3-858d-8594495d7df6",
      "name": "Groq (main model)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        900,
        560
      ],
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0.3,
          "maxTokensToSample": 2048
        }
      },
      "credentials": {
        "groqApi": {
          "id": "fk0N9mxbYr8EqEaP",
          "name": "Groq account"
        }
      }
    },
    {
      "id": "2793fe44-d18c-4dc8-9a36-52132c2b52b6",
      "name": "Gemini (backup model)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        1060,
        560
      ],
      "parameters": {
        "modelName": "models/gemini-flash-latest",
        "options": {
          "temperature": 0.3,
          "maxOutputTokens": 2048
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "iEXJevGkgXLcbG0R",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "bdc28053-b4df-40b3-bdce-27b6ef9acf00",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "calculator",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output }}",
                    "rightValue": "calculator",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "troubleshooter",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output }}",
                    "rightValue": "troubleshoot",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "hardware"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "96f345e6-db6b-47fd-9bcd-bf6eb8daf89c",
      "name": "Calculator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1500,
        120
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Prepare Request').first(0).json.message }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "=You are the Calculator of {{ $('Store Info').first(0).json.store_name }}, a computer-hardware store in Thailand. Reply in the customer's language (Thai or English), short and clear.\nWork out prices, totals and VAT for the products and quantities the customer asks about. Use the Calculator Tool for every sum; never calculate in your head. Use the price before VAT from PRODUCTS, then add VAT 7%.\nShow each line (name x qty = amount), the subtotal before VAT, VAT 7% and the total, in baht with 2 decimals.\nSay if a product is SOLD OUT or has less stock than asked. Only use products from PRODUCTS; if a product isn't there, say you can't find it.\n\nPRODUCTS (sku | name | category | price | stock | tags | description):\n{{ $('Prepare Request').first(0).json.products_text }}",
          "maxIterations": 8,
          "enableStreaming": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "dbaa3520-85a7-412b-a539-85ee08c2673b",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        1500,
        700
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Prepare Request').first(0).json.session_id }}",
        "contextWindowLength": 8
      }
    },
    {
      "id": "c9b1eb85-61ef-4332-987c-2f27a0907883",
      "name": "Calculator Tool",
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        1660,
        700
      ],
      "parameters": {}
    },
    {
      "id": "c54ca5ff-ae0e-4b65-8c87-630b27817291",
      "name": "Troubleshooter",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Prepare Request').first(0).json.message }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "=You are the Troubleshooter of {{ $('Store Info').first(0).json.store_name }}, a computer-hardware store in Thailand. Reply in the customer's language (Thai or English), short and friendly.\nHelp with product problems, setup, drivers, warranty, returns, orders and delivery. Give short numbered steps. Base product-specific steps on that product's description in PRODUCTS; don't guess from other brands.\nFor warranty, returns, opening hours and contact, use only STORE INFO. If the steps don't fix it, or it needs a repair, return or order check, ask the customer to contact the staff: {{ $('Store Info').first(0).json.contact }}.\n\nSTORE INFO:\nHours: {{ $('Store Info').first(0).json.hours }}\nPolicies: {{ $('Store Info').first(0).json.policies }}\nContact: {{ $('Store Info').first(0).json.contact }}\n\nPRODUCTS (sku | name | category | price | stock | tags | description):\n{{ $('Prepare Request').first(0).json.products_text }}",
          "maxIterations": 3,
          "enableStreaming": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "7a7b7b2e-92eb-45c9-ad50-7e154bbe1534",
      "name": "Hardware Expert",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1500,
        480
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Prepare Request').first(0).json.message }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "=You are the Hardware Expert of {{ $('Store Info').first(0).json.store_name }}, a computer-hardware store in Thailand. Reply in the customer's language (Thai or English), short and friendly.\nRecommend products that fit what the customer will use them for (competitive gaming, casual gaming, office or study, design). Give the price incl. VAT and say if it is in stock. Only use products from PRODUCTS; never invent products, specs or prices.\nSOLD-OUT RULE: if the product the customer wants is SOLD OUT, say so and first ask what they will use it for (for example FPS/MOBA gaming, office work, design). Do not recommend anything yet. When they answer, recommend 1-3 IN-STOCK products that fit that use, each with one short trade-off compared with the product they wanted.\n\nPRODUCTS (sku | name | category | price | stock | tags | description):\n{{ $('Prepare Request').first(0).json.products_text }}",
          "maxIterations": 3,
          "enableStreaming": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "2feec9ef-717e-48aa-9da2-b7bec0842af4",
      "name": "Reply to Website",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, agent: $prevNode.name, reply: $json.output || 'ขออภัยครับ ระบบขัดข้องชั่วคราว กรุณาลองใหม่อีกครั้ง / Sorry, something went wrong. Please try again.' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
