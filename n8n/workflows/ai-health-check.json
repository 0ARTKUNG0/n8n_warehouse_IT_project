    {
      "id": "30da9b96-a665-5852-9897-431bc4fe3d36",
      "name": "Health Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One line per model: does it answer, and what did it say? Run this after changing a model ID.\nconst MODELS = [{\"node\":\"Model 1 Groq GPT-OSS 120B\",\"provider\":\"groq\",\"model\":\"openai/gpt-oss-120b\"},{\"node\":\"Model 2 Groq Qwen 3.8 27B\",\"provider\":\"groq\",\"model\":\"qwen/qwen3.8-27b\"},{\"node\":\"Model 3 Typhoon 2.5 Thai\",\"provider\":\"typhoon\",\"model\":\"typhoon-v2.5-30b-a3b-instruct\"},{\"node\":\"Model 4 Gemini Flash-Lite\",\"provider\":\"gemini\",\"model\":\"gemini-flash-lite-latest\"},{\"node\":\"Model 5 Gemini Flash\",\"provider\":\"gemini\",\"model\":\"gemini-flash-latest\"},{\"node\":\"Model 6 OpenRouter Gemma 4 31B\",\"provider\":\"openrouter\",\"model\":\"google/gemma-4-31b-it:free\"}];\nconst report = MODELS.map(m => {\n  let r = {};\n  try { r = $(m.node).first(0)?.json ?? {}; } catch (e) { r = { error: e.message }; }\n  const content = r.choices?.[0]?.message?.content\n    ?? (r.candidates?.[0]?.content?.parts ?? []).map(p => p?.text ?? '').join('');\n  const text = typeof content === 'string' ? content.replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim() : '';\n  const e = r.error;\n  const error = typeof e === 'string' ? e : e?.message ?? '';\n  return { ...m, works: Boolean(text), answer: text.slice(0, 160), error: text ? '' : (error || 'no answer').slice(0, 300) };\n});\nreturn [{ json: { working: report.filter(r => r.works).length, of: report.length, models: report } }];\n"
      }
    },
