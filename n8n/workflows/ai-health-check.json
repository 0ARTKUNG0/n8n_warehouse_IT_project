        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": {{ JSON.stringify($('Normalize Input').first(0).json.messages) }},\n  \"temperature\": 0.2,\n  \"max_tokens\": {{ $('Normalize Input').first(0).json.max_tokens }},\n  \"reasoning_effort\": {{ JSON.stringify($('Normalize Input').first(0).json.reasoning_effort ?? \"medium\") }}\n}",
